# systemd unit — Linux servers / Raspberry Pi
# Installed by deploy/install-linux.sh (edit paths there, not here)
[Unit]
Description=Calendar AI Agent (Discord)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=__DIR__/.env
ExecStart=__DIR__/.venv/bin/python __DIR__/app/main.py
Restart=always
RestartSec=5
StandardOutput=append:__DIR__/logs/service.log
StandardError=append:__DIR__/logs/service.log

[Install]
WantedBy=multi-user.target
