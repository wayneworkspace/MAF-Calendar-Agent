# --- Discord ---
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# Your Discord numeric user ID (Settings → Advanced → Developer Mode, then right-click your name → Copy User ID)
ALLOWED_DISCORD_USER_IDS=123456789012345678
# Optional: channel IDs where the bot answers every message without being @mentioned
DISCORD_CHANNEL_IDS=

# --- Anthropic Claude ---
# console.anthropic.com → API Keys → Create Key (prepaid credits required, no free tier)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Google Calendar ---
GOOGLE_CALENDAR_ID=primary
# Where the OAuth files live. Docker: keep as data/ (mounted volume). Local: you may use credentials.json / token.json
GOOGLE_CREDENTIALS_FILE=data/credentials.json
GOOGLE_TOKEN_FILE=data/token.json
TIMEZONE=Asia/Ho_Chi_Minh

# --- Memory: how many recent user/assistant turns to keep per chat ---
MEMORY_WINDOW=20
